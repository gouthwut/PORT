{
  "identifier": "main",
  "description": "Main window: native folder picker and narrowly scoped external links",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Supermedo/bloodborne_pc" },
        { "url": "https://github.com/Supermedo/bloodborne_pc#requirements" },
        { "url": "https://github.com/Supermedo/bloodborne_pc/*" },
        { "url": "https://github.com/*/*" }
      ]
    }
  ]
}
