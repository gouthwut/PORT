    <DefineConstants>UPSTREAM</DefineConstants><PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>port-pkg-worker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../extractor-lab/Boundary.cs" Link="Boundary.cs" />
