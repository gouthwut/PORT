{
  "name": "port-launcher",
  "version": "0.1.0",
  "description": "PORT Windows native port launcher",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "playwright test",
    "format": "prettier --write \"{src,tests,scripts,docs,.github,src-tauri/src}/**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\" \"*.{json,ts,md}\" \"src-tauri/*.json\" \"tools/**/README.md\"",
    "format:check": "prettier --check \"{src,tests,scripts,docs,.github,src-tauri/src}/**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\" \"*.{json,ts,md}\" \"src-tauri/*.json\" \"tools/**/README.md\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
